<?xml version="1.0"?>
<ruleset name="Beplus Metadata AI Analyzer">
    <description>WPCS ruleset for the Beplus Metadata AI Analyzer plugin.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_supported_wp_version" value="5.0"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!-- File naming uses class-sso-*.php (already WP-Extra compliant) — no exclusions needed today. -->
    </rule>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="is_theme" value="false"/>
        </properties>
        <!-- Main plugin bootstrap file must be named after the plugin slug (WordPress
             convention), not after the SSO_Plugin class it contains. -->
        <exclude-pattern>beplus-metadata-ai-analyzer\.php$</exclude-pattern>
    </rule>

    <!-- Bootstrap file intentionally mixes the SSO_Plugin class with a handful of
         one-off activation/deactivation/upgrade-hook functions; splitting 3 small
         functions into their own file for this alone isn't worth the indirection. -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>beplus-metadata-ai-analyzer\.php$</exclude-pattern>
    </rule>
</ruleset>
